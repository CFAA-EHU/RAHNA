; _FEEDHOL,_STOP,CYSTART,AUXEND,_XFERINH
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; R_FEEDHOLC1                   ; Register bits to generate _FEEDHOLC1
; R_STOPC1                      ; Register bits to generate STOP en el CNC
; R_STARTC1                     ; Register bits for no START validation at CNC
; R_AUXENDC1                    ; Register bits to generate AUXEND
; R_XFERINHC1                   ; Bits to generate lock for reading _XFERINH
; R_INHIBITZ                    ; Register bits to generate INHIBITZ
; R_INHIBITC                    ; Register bits to generate INHIBITC
; R_INHIBITZ1                   ; Register bits to generate INHIBITZ1
; START                         ; Start key CNC operator panel
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; _FEEDHOLC1                    ; FEEDHOLD to the CNC.
; MSG10                         ; Message "no permission to move axes"
; MSG11                         ; Message "STOP generated via PLC"
; MSG12                         ; Message "START inhibit via PLC"
; MSG13                         ; Message "Reading block lockup via PLC"
; _STOPC1                       ; STOP of CNC.
; M_STARTC1                     ; Request for CYSTART
; CYSTARTC1                     ; Start CNC
; AUXENDC1                      ; AUXEND from CNC
; _XFERINHC1                    ; Lock CNC reading
; INHIBITZ                      ; Inhibit Z
; INHIBITC                      ; Inhibit C
; INHIBITZ1                     ; Inhibit Z1
;
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
;
; T011                          ; STOP pulse from CNC
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 390
;
;#END EXCEPTIONS
;
SUB CNC_PERMISSIONS
;
CPS R_FEEDHOLC1 EQ 0            ; Register bits to generate _FEEDHOLC1
  = _FEEDHOLC1                  ; FEEDHOLDC1 to the CNC.
;
NOT _FEEDHOLC1                  ; Feedhold not present
  AND M_MACHINE_POWER           ; Machine with power
  = MSG10                       ; Message "no permission to move axes"
;
CPS R_INHIBITZ NE 0             ; Register bits to generate INHIBITZ
  = INHIBITZ                    ; Inhibit Z
;
CPS R_INHIBITZ1 NE 0            ; Register bits to generate INHIBITZ1
  = INHIBITZ1                   ; Inhibit Z1
;
CPS R_INHIBITC NE 0             ; Register bits to generate INHIBITC
  = INHIBITC                    ; Inhibit C
;
CPS R_STOPC1 NE 0               ; Register bits to generate STOP at the CNC
  = TG1 011 100                 ; STOP pulse from CNC
  = MSG11                       ; Message "STOP generated by PLC"
;
NOT T011                        ; STOP pulse from CNC
  = _STOPC1                     ; STOP from CNC.
;
(START                          ; Start key CNC virtual operator panel
  OR I_START_OP)                ; Start key from operator panel
  AND CPS R_STARTC1 EQ 0        ; Register bits for no START validation at CNC
  AND CPS R_STOPC1 EQ 0         ; Register bits to generate STOP en el CNC
  = M_STARTC1                   ; Request for CYSTART
;
CPS R_STARTC1 NE 0              ; Register bits for no START validation at CNC
  AND M_MACHINE_POWER           ; Machine with power
  = MSG12                       ; Message " START inhibited by PLC"
;
M_STARTC1                       ; Request CYSTART
  = CYSTARTC1                   ; Start CNC
;
CPS R_AUXENDC1 EQ 0             ; Register bits to generate AUXEND
  = AUXENDC1                    ; AUXEND from CNC
;
CPS R_XFERINHC1 EQ 0            ; Bits to generate locking of reading _XFERINH
  = _XFERINHC1                  ; CNC reading locked
;
NOT _XFERINHC1                  ; CNC reading locked
   AND M_MACHINE_POWER          ; Machine with power
  = MSG13                       ; Message "Reading block lockup via PLC"
;
END
