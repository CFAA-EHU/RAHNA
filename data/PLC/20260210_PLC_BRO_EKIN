;
;#BEGIN EXCEPTIONS
;
; #Order number = 194
;
;#END EXCEPTIONS
;
SUB DOORS_SAFETY
;
I_DOOR_F_CLOSED                 ; Front door closed
  AND NOT I_DOOR_F_KEY_OUT      ; Front door key present
  = M_DOOR_F_CLOSE              ; Front door closed
;
NOT I_DOOR_F_CLOSED             ; Front door opened
  OR I_DOOR_F_KEY_OUT           ; Front door key not present
  = MSG3                        ; Front door opened
;
I_DOOR_L_CLOSED                 ; Left door closed
  AND  I_DOOR_L_KEY_IN          ; Left door key present
  = M_DOOR_L_CLOSE              ; Left  door closed
;
NOT I_DOOR_L_CLOSED             ; Left door opened
  OR NOT I_DOOR_L_KEY_IN        ; Left door not key present
  = MSG4                        ; Left door opened
;
I_DOOR_R_CLOSED                 ; Right door closed
  AND  I_DOOR_R_KEY_IN          ; Right door key present
  = M_DOOR_R_CLOSE              ; Right  door closed
;
NOT I_DOOR_R_CLOSED             ; Right door opened
  OR NOT I_DOOR_R_KEY_IN        ; Right door key not present
  = MSG5                        ; Right door opened
;
 I_DOOR_SC_KEY_IN               ; Interior scuttle door closed
  = M_DOOR_SCUTTLE_CLOSE        ; Interior scuttle door closed
;
NOT I_DOOR_SC_KEY_IN            ; Interior scuttle key out
  = M_DOOR_SCUTTLE_OPEN         ; Interior scuttle door opened
  = MSG6                        ; Interior scuttle door opened
;
M_DOOR_F_CLOSE                  ; Front door closed
  AND M_DOOR_L_CLOSE            ; Left  door closed
  AND M_DOOR_R_CLOSE            ; Right  door closed
  AND M_DOOR_SCUTTLE_CLOSE      ; Interior scuttle door closed
  = M_DOOR_CLOSED               ; Doors closed
;
NOT M_DOOR_CLOSED               ; Doors closed
  = B4R_STARTC1                 ; No START: Door open, CNC not manual modes
;
STARTC1                         ; START key, CNC operator panel
  AND B4R_STARTC1               ; No START: Door open, CNC not manual modes
  = SET M_DOOR_OPEN_NO_START    ; Start has been pressed while door open
;
RESETOUTC1                      ; CNC reset
  OR DFD B4R_STARTC1            ; No START: Door open, CNC not manual modes
  OR NOT M_MACHINE_POWER        ; Machine with power
  = RES M_DOOR_OPEN_NO_START    ; Start has been pressed while door open
;
M_DOOR_OPEN_NO_START            ; Start has been pressed while door open
  AND CLK800                    ; Intermittent mark, 800 ms
  = MSG24                       ; No Start while door open.
;
I_SETUP_MODE                    ; Machine selector in SETUP mode
  = TG3 081 1000                ; SETUP mode selector input extension
;
T081                            ; SETUP mode selector input extension
  = M_SETUP_MODE                ; Machine in SETUP mode
;
M_SETUP_MODE                    ; Machine in SETUP mode
  = B7R_STARTC1                 ; No START: SETUP mode
  = MSG31                       ; Machine in SETUP mode
;
I_DOOR_OPEN_ENABLE              ; Opening doors enabled
  AND M_SETUP_MODE              ; Machine in SETUP mode
  = M_DOOR_OPEN_ENABLE          ; Enable operate with open doors
;
()                              ; "1" logico
  = CNCRD(A.TPOS.Z,R_TPOS_Z,M_CNCRD_SYN); Z-axis position
;
INPOSZ                          ; Z axis in position
  AND INPOSC                    ; C axis in position
  AND NOT INCYCLEC1             ; CNC in execution
  AND M_MANUALC1                ; CNC in manual modes
  AND M_SETUP_MODE              ; Machine in SETUP mode
  = M_DOOR_OPEN_COND            ; Door opening conditions
;
CPS R_TPOS_Z GE R_L_LOW         ; Lower limit of door opening position
  AND CPS R_TPOS_Z LE R_L_UP    ; Upper limit of door opening position
  AND M_DOOR_OPEN_COND          ; Door opening conditions
  = M_DOOR_L_INPOSZ             ; Z-axis in position to open left door
;
CPS R_TPOS_Z GE R_R_LOW         ; Lower limit of door opening position
  AND CPS R_TPOS_Z LE R_R_UP    ; Upper limit of door opening position
  = M_GANTRY_POS_MIDDLE         ; Z-axis middle position
;
M_GANTRY_POS_MIDDLE             ; Z-axis middle position
  AND M_DOOR_OPEN_COND          ; Door opening conditions
  = M_DOOR_R_INPOSZ             ; Z-axis in position to open right door
;
I_DOOR_OPEN_PB                  ; Door opening push-button
  AND M_DOOR_L_INPOSZ           ; Z-axis in position to open left door
  = SET M_DOOR_L_OPEN_REQ       ; Left door opening request accepted
;
M_DOOR_L_OPEN_REQ               ; Left door opening request accepted
  = TG2 083 10000               ; Keep doors open request
;
T083                            ; Keep doors open request
  = RES M_DOOR_L_OPEN_REQ       ; Left door opening request accepted
;
I_DOOR_OPEN_PB                  ; Door opening push-button
  AND M_DOOR_R_INPOSZ           ; Z-axis in position to open left door
  = SET M_DOOR_R_OPEN_REQ       ; Right door opening request accepted
;
M_DOOR_R_OPEN_REQ               ; Right door opening request accepted
  = TG2 084 10000               ; Keep doors open request
;
T084                            ; Keep doors open request
  = RES M_DOOR_R_OPEN_REQ       ; Right door opening request accepted
;
I_DOOR_OPEN_PB                  ; Door opening push-button
  AND M_DOOR_OPEN_COND          ; Door opening conditions
  = SET M_DOOR_F_OPEN_REQ       ; Front door opening request accepted
;
M_DOOR_F_OPEN_REQ               ; Front door opening request accepted
  = TG2 085 10000               ; Keep doors open request
;
T085                            ; Keep doors open request
  = RES M_DOOR_F_OPEN_REQ       ; Front door opening request accepted
;
M_DOOR_L_OPEN_REQ               ; Left door opening request accepted
  = O_DOOR_L_UNLOCK             ; Left door unlock
  = MSG7                        ; Unlock left door enable
;
M_DOOR_R_OPEN_REQ               ; Right door opening request accepted
  = O_DOOR_R_UNLOCK             ; Right door unlock
  = MSG8                        ; Unlock right door enable
;
M_DOOR_F_OPEN_REQ               ; Front door opening request accepted
  = O_DOOR_F_UNLOCK             ; Front door unlock
  = O_DOOR_S_UNLOCK             ; Interior scuttle unlock
  = MSG9                        ; Unlock front door enable
;
M_DOOR_OPEN_COND                ; Door opening conditions
  AND M_DOOR_CLOSED             ; Door closed
  OR NOT M_DOOR_CLOSED          ; Door closed
  AND CLK800                    ; Intermittent mark, 800 ms
  = O_LED_DOOR_OPEN             ; Door opening conditions led
;
NOT M_DOOR_CLOSED               ; Door closed
  AND M_SETUP_MODE              ; Machine in SETUP mode
  AND M_DOOR_OPEN_ENABLE        ; Opening doors enabled
  = M_DOOR_AUX_LIMIT            ; Limitations due to open door
  = O_LED_DOOR_ENABLE           ; Enable operate with open doors
;
M_MAN_INT_AUTO                  ; CNC in manual intervention in automatic
  OR M_DOOR_AUX_LIMIT           ; Limitations due to open door
  = FLIMITAC                    ; Fmax with open door
;
NOT M_DOOR_CLOSED               ; Door closed
  AND NOT M_DOOR_AUX_LIMIT      ; Limitations due to open door
  = B4R_STOPC1                  ; STOP, open door
  = B8R_FEEDHOLC1               ; FEEDHOLDC1, open door
;
(M_DOOR_CLOSED                  ; Doors closed
  OR M_DOOR_AUX_LIMIT)          ; Limitations due to open door
  AND I_PILZ_OK                 ; Condiciones de rearme OK
  = M_AXES_ENABLE_AUX           ; Aux. axis enable permission
  = TG3 086 500                 ; Delay axis enable permission
;
T086                            ; Delay axis enable permission
  = M_AXES_ENABLE               ; Axis enable permission
;
NOT M_AXES_ENABLE               ; Axis enable permission
  = B17KEYDIS1                  ; Inhibit Z+ key
  = B23KEYDIS1                  ; Inhibit Z- key
  = B21KEYDIS1                  ; Inhibit C+ key
  = B19KEYDIS1                  ; Inhibit C- key
;
NOT M_DOOR_CLOSED               ; Door closed
  AND M_DOOR_OPEN_NO_START      ; Start has been pressed while door open
  AND NOT MSG24                 ; No Start while door open.
  = MSG25                       ; Door open
;
END
