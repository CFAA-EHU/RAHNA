;------------------------------------------------------------------------------
;                        STROBE MANAGER
;------------------------------------------------------------------------------
;******************************************************************************
; Check if an M function has been executed
; Generate an AUXEND pulse for any M function
; M function marks last one PLC scan (M100 up to M199 are in use)
;
;******************************************************************************
;                         INPUT RESOURCE
;******************************************************************************
;
; MSTROBEC1                     ; Flank of MSTROBEC1
;
;******************************************************************************
;                         OUTPUT RESOURCE
;******************************************************************************
;
; M_MSTROBEC1                   ; Scan with M functions
; B1R_AUXENDC1                  ; AUXEND due to M auxiliary functions
;
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
;
; T001                          ; AUXEND pulse due to strobes (20 ms)
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 120
;
;#END EXCEPTIONS
;
SUB STROBE
;
DFU MSTROBEC1                   ; Flank of MSTROBEC1
  = M_MSTROBEC1                 ; Scan with M functions
  = TG1 001 20                  ; AUXEND pulse due to strobes (20 ms)
;
T001                            ; AUXEND pulse due to strobes (20 ms)
  = B1R_AUXENDC1                ; AUXEND due to M auxiliary functions
;
DFD M_MSTROBEC1                 ; End of scan with M functions
  = ERA M100 499                ; Erase M functions
;
END
