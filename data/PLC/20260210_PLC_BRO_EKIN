  AND DFD I_MAYR_BRAKE_COMP_R2  ; Mayr brake right compensation side detector 2
  = SET M_MAYR_BRAKE_COMP_R2    ; Mayr brake right compensation side detector 2
;
I_MAYR_BRAKE_L1                 ; Mayr brake left guide detector 1
  AND I_MAYR_BRAKE_R1           ; Mayr brake right guide detector 1
  AND I_MAYR_BRAKE_COMP_L1      ; Mayr brake left compensation side detector 1
  AND I_MAYR_BRAKE_COMP_R1      ; Mayr brake right compensation side detector 1
  AND I_MAYR_BRAKE_COMP_L2      ; Mayr brake left compensation side detector 2
  AND I_MAYR_BRAKE_COMP_R2      ; Mayr brake right compensation side detector 2
  = TG2 113 1000
;
T113
  = M_MAYR_BRAKE_LOCK           ; Toolholder MAYR brake lock detectors ok
;
M_MAYR_BRAKE                    ; Toolholder MAYR brake unlock
  AND DFD M_MAYR_BRAKE_LOCK     ; Toolholder MAYR brake lock detectors ok
  = SET M_MAYR_BRAKE_SW_DFD     ; Toolholder MAYR brake lock detectors down flank
;
NOT M_MAYR_BRAKE                ; Toolholder MAYR brake unlock
