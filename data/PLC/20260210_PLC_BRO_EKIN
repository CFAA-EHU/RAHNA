;------------------------------------------------------------------------------
;                       READ PARAMETERS OF MACHINE OPTIONS
;------------------------------------------------------------------------------
;******************************************************************************
;
; MTB machine parameters of the CNC are use to choose machine options
;
; MTB.P[2]                      ; Pause between lub.(min.)
; MTB.P[10]                     ; Automatic parallelism correction
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
; M_GANTRY_ON_Z                 ; Gantry active on Z axis
; M_GANTRY_DIFFCOMPZ            ; Automatic parallelism correctio
; R_TIME_PAUSE_LUB              ; Pause between lub.(min.)
; R_MASTERAXIS                  ; Gantry master axis 1
; R_SLAVEAXIS                   ; Gantry slave axis 1
; R_WARNCOUPE                   ; Maximum difference for warning (WARNCOUPE)
; R_MAXDIFF                     ; Maximum difference allowed (MAXDIFF)
; R_DIFFCOMPZ                   ; Automatic parallelism correction
;
;******************************************************************************
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #ERA_MARK2 M_CNCRD_SYN
;
; #Order number = 150
;
;#END EXCEPTIONS
;
SUB OPTIONS
;
; ------- Z-axis position -----------------------------------------
;
()                              ; Logic "1"
  = CNCRD(MTB.PF[0],R_POSZ_L,M_CNCRD_SYN); Z-axis position to open left door
  = ADS R_POSZ_L 50000 R_L_UP   ; Upper limit of door opening position
  = SBS R_POSZ_L 10000 R_L_LOW  ; Lower limit of door opening position
;
()                              ; Logic "1"
  = CNCRD(MTB.PF[1],R_POSZ_R,M_CNCRD_SYN); Z-axis position to open right door
  = ADS R_POSZ_R 50000 R_R_UP   ; Upper limit of door opening position
  = SBS R_POSZ_R 50000 R_R_LOW  ; Lower limit of door opening position
;
()                              ; Logic "1"
  = CNCRD(MTB.PF[20],R_POSZ_ZI,M_CNCRD_SYN); Z-axis position for start of machining
  = ADS R_POSZ_ZI 50000 R_ZI_UP  ; Upper limit of Z-axis start position
  = SBS R_POSZ_ZI 10000 R_ZI_LOW ; Lower limit of Z-axis start position
;
()                              ; Logic "1"
  = CNCRD(MTB.PF[21],R_POSZ_ZF,M_CNCRD_SYN); Z-axis position for end of machining
  = ADS R_POSZ_ZF 50000 R_ZF_UP ; Upper limit of Z-axis end position
  = SBS R_POSZ_ZF 10000 R_ZF_LOW ; Lower limit of Z-axis end position
;
; ------- Read lubrication parameters -----------------------------------------
;
()                              ; Logic "1"
  = CNCRD(MTB.P[2],R_TIME_PAUSE_LUB,M_CNCRD_SYN); Pause between lub.(h.)
;
CPS R_TIME_PAUSE_LUB LE 0       ; Pause between lubrication not definited
  = MOV 12 R_TIME_PAUSE_LUB     ; Preset 12 hours
;
; ------- Read Gantry parameters
;
()                              ; "1" logico
  = CNCRD(MPG.MASTERAXIS[1],R_MASTERAXIS,M_CNCRD_SYN); Gantry master axis 1
  = CNCRD(MPG.SLAVEAXIS[1],R_SLAVEAXIS,M_CNCRD_SYN) ; Gantry slave axis 1
  = CNCRD(MPG.WARNCOUPE[1],R_WARNCOUPE,M_CNCRD_SYN); Maximum difference for warning (WARNCOUPE)
  = CNCRD(MPG.MAXDIFF[1],R_MAXDIFF,M_CNCRD_SYN) ; Maximum difference allowed (MAXDIFF)
  = CNCRD(MTB.P[10],R_DIFFCOMPZ,M_CNCRD_SYN) ; Automatic parallelism correction
  = CNCRD(MTB.P[11],R_GANTRYOFF,M_CNCRD_SYN) ; CNC decouples the gantry axis
;
CPS R_GANTRYOFF EQ 1            ; CNC decouples the gantry axis
  = M_GANTRYOFF                 ; CNC decouples the gantry axis
;
CPS R_MASTERAXIS EQ 1           ; Gantry master Z axis
  AND CPS R_SLAVEAXIS EQ 3      ; Gantry slave Z1 axis
  = M_GANTRY_ON_Z               ; Gantry active on Z axis
;
M_GANTRY_ON_Z                   ; Gantry active on Z axis
  AND NOT M_GANTRYOFF           ; CNC decouples the gantry axis
  AND CPS R_DIFFCOMPZ EQ 1      ; Automatic parallelism correction
  = M_GANTRY_DIFFCOMPZ          ; Automatic parallelism correction
;
M_GANTRY_DIFFCOMPZ              ; Automatic parallelism correction
  AND CPS R_MAXDIFF LE 0        ; Maximum permissible difference not defined
  = ERR9                        ; Set Gantry 1 MAXDIFF parameter
;
END                             ; End reading of machine conditions parameters
