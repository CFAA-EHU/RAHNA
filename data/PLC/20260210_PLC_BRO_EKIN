;-------------------------------------------------------------------------
;                         END-OF-CYCLE BEACON
;-------------------------------------------------------------------------
;
;*************************************************************************
;                         INPUT RESOURCES
;*************************************************************************
;
; M_DOOR_CLOSED                 ; Door closed
; B6KEYBD2                      ; START key on operator panel
; B7KEYBD2                      ; STOP key on operator panel
; CNCREADY                      ; CNC with no errors
; M01STOP                       ; M01STOP status active
; _STOP                         ; Program stop by PLC
; FHOUTC1                       ; CNC, program execution stopped
; INCYCLEC1                     ; CNC in execution
; RESETOUTC1                    ; CNC reset
; M_EMERGEN                     ; CNC emergency
; M_M0_C1                       ; M00: Program stop
; M_M1_C1                       ; Conditional program stop
; M_M2_C1                       ; End of program
; M_M30_C1                      ; End of program
; M_MACHINE_POWER               ; Machine with power
;
;*************************************************************************
;                         OUTPUT RESOURCES
;*************************************************************************
;
; O_CNC_INCYCLE                 ; Green beacon output
; O_CNC_CYCLE_END               ; End-of-cycle beacon
; O_CNC_ERROR                   ; Emergency beacon
;
;*************************************************************************
;                         INTERNAL RESOURCES
;*************************************************************************
;
; M_BEACON_EMERGEN              ; Emergency beacon
; M_BEACON_END                  ; End-of-program beacon
;
;*************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 801
;
;#END EXCEPTIONS
;
SUB WARNING_LIGHT
;
NOT M_EMERGEN                   ; CNC emergency
  OR NOT CNCREADY               ; CNC with no errors
  = M_BEACON_EMERGEN            ; Red LED
;
M_M0_C1                         ; Program stop M0
  OR M_M2_C1                    ; End of program
  OR M_M30_C1                   ; End of program
  OR (M_M1_C1                   ; Conditional program stop
  AND M01STOP)                  ; M01STOP status active
  OR DFU _STOP                  ; Program stop by PLC
  = SET M_BEACON_END            ; End-of-program beacon
;
DFU INCYCLEC1                   ; CNC in execution
  OR DFD M_DOOR_CLOSED          ; Door closed
  OR RESETOUTC1                 ; CNC reset
  OR M_STARTC1                  ; Request for CYSTART
  OR NOT M_MACHINE_POWER        ; Machine with power
  = RES M_BEACON_END            ; End-of-program beacon
;
  M_BEACON_END                  ; End-of-program beacon
  AND CLK1000                   ; Flashing mark 1000 ms (1 s)
  = O_CNC_CYCLE_END             ; WARNING_LIGHT end of cycle, orange
;
M_BEACON_EMERGEN                ; Emergency beacon
  AND CLK400                    ; Flashing mark 400 ms
  = O_CNC_ERROR                 ; Emergency beacon
;
INCYCLEC1                       ; CNC in execution
  OR (FHOUTC1                   ; CNC, program execution stopped
  AND CLK400)                   ; Timer 400 ms
  = O_CNC_INCYCLE               ; Green beacon output
;
END
