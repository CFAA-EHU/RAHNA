;------------------------------------------------------------------------------
;                           PNEUMATIC
;------------------------------------------------------------------------------
;******************************************************************************
;
; It monitors the pressure of general air input
; Activation of general air flow
; Tool cleaner
;******************************************************************************
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; I_AIR_PRESSURE                ; General air pressure switch
; I_TOOL_CLEANER_OUT            ; Tool cleaning detector forward
; I_TOOL_CLEANER_IN             ; Tool cleaning detector back
; M_M20_C1                      ; M20: Tool cleaning backward
; M_M21_C1                      ; M21: Tool cleaning forward
; M_MACHINE_POWER               ; Machine with power
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; O_AIR_GENERAL                 ; Activation of general air flow
; O_TOOL_CLEANER_BACK           ; Retracting tool cleaning device
; O_TOOL_CLEANER_FORW           ; Advance tool cleaning device
; M_AIR_PRESSURE                ; General air pressure switch
; B7R_FEEDHOLC1                 ; FEEDHOLDC1, general air pressure failure
; B0R_STOPC1                    ; STOP, general air pressure failure
; B1R_STARTC1                   ; No START, general air pressure failure
; B1R_XFERINHC1                 ; Reading locked up, general air press. failure
; MSG18                         ; No general air pressure
; MSG19                         ; Non-positioned tool cleaning
;
;******************************************************************************
;
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
; T016                          ; Confirm general air pressure failure
; T017                          ; Confirm tool cleaning detector forward
; T018                          ; Confirm tool cleaning detector back
;
;******************************************************************************
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 370
;
;#END EXCEPTIONS
;
SUB PNEUMATIC
;
I_AIR_PRESSURE                  ; General air pressure switch
  = M_AIR_PRESSURE              ; General air pressure switch
;
I_AIR_LINEAR_PRESS              ; Linear encoder air pressure switch
  = M_AIR_LINEAR_PRESS          ; Linear encoder air pressure switch
;
NOT M_AIR_PRESSURE              ; General air pressure switch
  AND M_MACHINE_POWER           ; Machine with power
  = TG2 016 500                 ; Confirm general air pressure failure
;
T016                            ; Confirm general air pressure failure
  = MSG18                       ; No general air pressure
;
MSG18                           ; No general air pressure
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = B7R_FEEDHOLC1               ; FEEDHOLDC1, general air pressure failure
  = B0R_STOPC1                  ; STOP, general air pressure failure
  = B1R_STARTC1                 ; No START, general air pressure failure
  = B1R_XFERINHC1               ; Reading locked up, general air press. failure
;
NOT M_AIR_LINEAR_PRESS          ; Linear encoder air pressure switch
  AND M_MACHINE_POWER           ; Machine with power
  = TG2 019 1000                ; Confirm linear encoder air pressure failure
;
T019                            ; Confirm linear encoder air pressure failure
  = MSG42                       ; No linear encoder air pressure
;
MSG42                           ; No linear encoder air pressure
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = B9R_FEEDHOLC1               ; FEEDHOLDC1, linear encoder air pressure failure
  = B9R_STARTC1                 ; No START, linear encoder air pressure failure
;
M_MACHINE_POWER                 ; Machine with power
  = O_AIR_GENERAL               ; Activation of general air flow
;
I_TOOL_CLEANER_OUT              ; Tool cleaning detector forward
  AND NOT I_TOOL_CLEANER_IN     ; Tool cleaning detector back
  = TG2 017 200                 ; Confirm tool cleaning detector forward
;
T017                            ; Confirm tool cleaning detector forward
  = M_TOOL_CLEANER_OUT          ; Tool cleaning detector forward
  = M_SM_TOOL_CLEANER_OUT       ; Screen monitoring: Tool cleaning detector forward
;
I_TOOL_CLEANER_IN               ; Tool cleaning detector back
  AND NOT I_TOOL_CLEANER_OUT    ; Tool cleaning detector forward
  = TG2 018 200                 ; Confirm tool cleaning detector back
;
T018                            ; Confirm tool cleaning detector back
  = M_TOOL_CLEANER_IN           ; Tool cleaning detector back
  = M_SM_TOOL_CLEANER_IN        ; Screen monitoring: Tool cleaning detector back
;
ENABLEZ                         ; Movement of the Z-axis
  AND NOT DIRZ                  ; Moves the Z axis in the positive direction
  = TG2 013 200                 ; Confirmation Z axis moves in the positive direction
;
T013                            ; Confirmation Z axis moves in the positive direction
  = M_ENABLEZ_POS               ; Z axis moves in the positive direction
;
ENABLEZ                         ; Movement of the Z-axis
  AND DIRZ                      ; Moves the Z axis in the negative direction
  = TG2 014 200                 ; Confirmation Z axis moves in the negative direction
;
T014                            ; Confirmation Z axis moves in the negative direction
  = M_ENABLEZ_NEG               ; Z axis moves in the negative direction
;
(M_M20_C1                       ; M20: Tool cleaning backward
  OR M_SM_CLEANER_BACK          ; Screen monitoring: Tool cleaning backward
  OR DFU M_BROACHING_CYCLE      ; Broaching cycle
  OR M_ENABLEZ_POS)             ; Z axis moves in the positive direction
  AND M_TABLE_COND              ; Table movement conditions
  AND M_MACHINE_POWER           ; Machine with power
  = SET M_TOOL_CLEANER_BACK     ; Tool cleaning backward
  = RES M_TOOL_CLEANER_FORW     ; Tool cleaning forward
;
(M_M21_C1                       ; M21: Tool cleaning forward
  OR M_SM_CLEANER_FORW          ; Screen monitoring: Tool cleaning forward
  OR M_BROACHING_CYCLE          ; Broaching cycle
  AND M_ENABLEZ_NEG)            ; Z axis moves in the negative direction
  AND M_MACHINE_POWER           ; Machine with power
  AND M_TABLE_COND              ; Table movement conditions
  = SET M_TOOL_CLEANER_FORW     ; Tool cleaning forward
  = RES M_TOOL_CLEANER_BACK     ; Tool cleaning backward
;
DFU M_TOOL_CLEANER_BACK         ; Tool cleaning backward
  OR DFU M_TOOL_CLEANER_FORW    ; Tool cleaning forward
  = SET M_TOOL_CLEANER_AUX      ; Aux Tool cleaning
;
M_TOOL_CLEANER_BACK             ; Tool cleaning backward
  AND M_TOOL_CLEANER_IN         ; Tool cleaning detector back
  OR M_TOOL_CLEANER_FORW        ; Tool cleaning forward
  AND M_TOOL_CLEANER_OUT        ; Tool cleaning detector forward
  OR NOT M_MACHINE_POWER        ; Machine with power
  = RES M_TOOL_CLEANER_AUX      ; Aux Tool cleaning
;
M_ENABLEZ_POS                   ; Z axis moves in the positive direction
  AND NOT M_TOOL_CLEANER_IN     ; Tool cleaning detector back
  OR M_ENABLEZ_NEG              ; Z axis moves in the negative direction
  AND NOT M_TOOL_CLEANER_IN     ; Tool cleaning detector back
  AND NOT M_TOOL_CLEANER_OUT    ; Tool cleaning detector forward
  = M_TOOL_CLEANER_NOPOS        ; Non-positioned tool cleaning
  = B6R_FEEDHOLC1               ; FEEDHOLDC1, Non-positioned tool cleaning
  = B6R_STOPC1                  ; STOP, Non-positioned tool cleaning
;
M_TOOL_CLEANER_AUX              ; Aux Tool cleaning
  = B3R_AUXENDC1                ; AUXEND: Tool cleaning
  = B16R_FEEDHOLC1              ; FEEDHOLDC1, Tool cleaning not backwards
;
M_TOOL_CLEANER_AUX              ; Aux Tool cleaning
  OR M_TOOL_CLEANER_NOPOS       ; Non-positioned tool cleaning
  = MSG19                       ; Non-positioned tool cleaning
;
M_TOOL_CLEANER_BACK             ; Tool cleaning backward
  AND M_MACHINE_POWER           ; Machine with power
  = O_TOOL_CLEANER_BACK         ; Retracting tool cleaning device
;
M_TOOL_CLEANER_FORW             ; Tool cleaning forward
  AND M_MACHINE_POWER           ; Machine with power
  = O_TOOL_CLEANER_FORW         ; Advance tool cleaning device
;
END
