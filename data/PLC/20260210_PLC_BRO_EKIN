  OR DFD CLK1000                ; Flank every second
  = CUP 001                     ; Counter for seconds machine on
;
CPS C001 GE 60                  ; Counter for seconds machine on = 60 s
  = CUP 002                     ; Counter for minutes machine on
  = CPR 001 0                   ; Counter for seconds machine on = 0 s
;
CPS C002 GE 60                  ; Counter for minutes machine on = 60 min.
  = CUP 003                     ; Counter for hours machine on
  = CPR 002 0                   ; Counter for minutes machine on = 0 min.
;
; **** IN EXECUTION
;
(DFU CLK1000                    ; Flank every second
  OR DFD CLK1000)               ; Flank every second
  AND INCYCLEC1                 ; CNC in execution
  = CUP 004                     ; Total Counter for seconds CNC in execution
  = CUP 014                     ; Partial Counter for seconds CNC in execution
;
CPS C004 GE 60                  ; Total Counter for seconds CNC in execution = 60 s
  = CUP 005                     ; Total Counter for minutes CNC in execution
  = CPR 004 0                   ; Total Counter for seconds CNC in execution = 0 s
;
CPS C014 GE 60                  ; Partial Counter for seconds CNC in execution = 60 s
  = CUP 015                     ; Partial Counter for minutes CNC in execution
  = CPR 014 0                   ; Partial Counter for seconds CNC in execution = 0 s
;
CPS C005 GE 60                  ; Total Counter for minutes CNC in execution = 60 min.
  = CUP 006                     ; Total Counter for hours the CNC in execution
  = CPR 005 0                   ; Total Counter for minutes CNC in execution = 0 min.
;
CPS C015 GE 60                  ; Partial Counter for minutes CNC in execution = 60 min.
  = CUP 016                     ; Partial Counter for hours partial the CNC in execution
  = CPR 015 0                   ; Partial Counter for minutes CNC in execution = 0 min.
;
M_RESET_TIMERS                  ; Reset machine timers
  = CPR 014 0                   ; Partial Counter for seconds CNC in execution = 0 s
  = CPR 015 0                   ; Partial Counter for minutes CNC in execution = 0 min
  = CPR 016 0                   ; Partial Counter for hours partial the CNC in execution
  = RES M_RESET_TIMERS          ; Reset machine timers
