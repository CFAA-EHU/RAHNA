SUB ELECTRIC_CABINET
;
I_COOL_CABINET_THS              ; Electric cabinet air conditioner thermal switch
  = M_COOL_CABINET_THS          ; Electric cabinet air conditioner thermal switch
;
I_COOL_CABINET_FAULT            ; Cabinet climate controler failure
  = M_COOL_CABINET_FAULT        ; Cabinet climate controler failure
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_COOL_CABINET_THS    ; Electric cabinet air conditioner thermal switch
  = MSG45                       ; Electric cabinet air conditioner thermal switch failure
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_COOL_CABINET_FAULT  ; Cabinet climate controler failure
  = MSG46                       ; Cabinet climate controler failure
;
END
