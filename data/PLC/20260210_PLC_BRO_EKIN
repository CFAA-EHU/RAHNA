;=============================================================================
;                 DECODING OF M FUNCTIONS
;=============================================================================
;
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 130
;
;#END EXCEPTIONS
;
SUB MFUNC1
;
CPS MFUNC1* EQ 0 = M_M0_C1      ; Program stop M0
CPS MFUNC1* EQ 1 = M_M1_C1      ; Conditional program stop
CPS MFUNC1* EQ 2 = M_M2_C1      ; M2 function
CPS MFUNC1* EQ 8 = M_M8_C1      ; M8: coolant by broach coolant
CPS MFUNC1* EQ 9 = M_M9_C1      ; M9: Cancel tool coolant
CPS MFUNC1* EQ 10 = M_M10_C1    ; M10: Table axis dead
CPS MFUNC1* EQ 11 = M_M11_C1    ; M11: Table axis alive
CPS MFUNC1* EQ 20 = M_M20_C1    ; M20: Tool cleaning backward
CPS MFUNC1* EQ 21 = M_M21_C1    ; M21: Tool cleaning forward
CPS MFUNC1* EQ 30 = M_M30_C1    ; M30 function
CPS MFUNC1* EQ 50 = M_M50_C1    ; M50: Lights on
CPS MFUNC1* EQ 51 = M_M51_C1    ; M51: Lights off
CPS MFUNC1* EQ 90 = M_M90_C1    ; M90: Tune up mode
CPS MFUNC1* EQ 91 = M_M91_C1    ; M91: End Tune up mode
CPS MFUNC1* EQ 92 = M_M92_C1    ; M92: Activate chip conveyor
CPS MFUNC1* EQ 93 = M_M93_C1    ; M93: Stop chip conveyor
CPS MFUNC1* EQ 95 = M_M95_C1    ; M95: Additional lubrication
CPS MFUNC1* EQ 96 = M_M96_C1    ; M96: Enable Z-axis movements without parallelism
CPS MFUNC1* EQ 100 = M_M100_C1  ; M100: Start of broaching cycle
CPS MFUNC1* EQ 101 = M_M101_C1  ; M101: End of broaching cycle
;
END                             ; End of subroutine to decode M functions
