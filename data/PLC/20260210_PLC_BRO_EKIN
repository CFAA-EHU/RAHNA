;------------------------------------------------------------------------------
;                         CNC EMERGENCY SUBROUTINE
;------------------------------------------------------------------------------
;******************************************************************************
;
; 1.-It checks all the PLC errors, but only errors 1 to 128 (ERR1 to ERR128)
;    are taken into account to remove power.
;
;******************************************************************************
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; I_EMERGEN                     ; General emergency
; I_POWER_ON                    ; Power on
; R_DR_STATUS                   ; Power enable register
; R_DR_NOT_POWER                ; Drives without power
;
;*************************************************************************
;                         OUTPUT RESOURCES
;*************************************************************************
;
; O_EMERGEN                     ; Emergency from the CNC
; M_MACHINE_POWER               ; Machine with power
; _EMERGEN                      ; Emergency to the CNC
; B0R_FEEDHOLC1                 ; FEEDHOLDC1, machine without power
; B0R_STARTC1                   ; No START, machine without power
; B0R_AUXENDC1                  ; AUXEND because the machine has no power
; B0R_XFERINHC1                 ; Reading locked up, machine without power
; B11KEYDIS2                    ; Inhibit homing (ZERO) key
; MSG1                          ; Machine without power
; ERR11                         ; Discrepancy safety relay
; ERR12                         ; Emergency switch from Operator panel
; ERR13                         ; Power supply external I/O outputs fault
; ERR14                         ; Inputs power supply ET200SP fault
; ERR15                         ; Safety power supply fault
; ERR16                         ; CNC power supply fault
; ERR17                         ; Operator panel power supply fault
; ERR18                         ; Output power supply ET200SP fault
; ERR19                         ; Fagor power supply protection fault
; ERR20                         ; Drives power supply fault
;*************************************************************************
;                         INTERNAL RESOURCES
;*************************************************************************
;
; M_PLC_ERROR                   ; Some PLC error activated
; R_ERR1_32                     ; ERR1-ERR32
; R_ERR33_64                    ; ERR33-ERR64
; R_ERR65_96                    ; ERR65-ERR96
; R_ERR97_128                   ; ERR97-ERR128
;
;*************************************************************************
;                         EXCEPTIONS
;*************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 190
;
;#END EXCEPTIONS
;
SUB EMERGENCY
;
NOT I_SAFETY_RELAY              ; Discrepancy safety relay
  AND CNCREADY                  ; CNC with no errors
  = ERR11                       ; Discrepancy safety relay
;
NOT I_PS_EXT_IO_HEADER          ; Power supply external I/O header
  AND CNCREADY                  ; CNC with no errors
  = ERR12                       ; Emergency switch from Operator panel
;
NOT I_PS_EXT_IO_OUT             ; Power supply external I/O outputs
  AND CNCREADY                  ; CNC with no errors
  = ERR13                       ; Power supply external I/O outputs fault
;
NOT I_PS_IN_ET200SP             ; Inputs power supply ET200SP
  AND CNCREADY                  ; CNC with no errors
  = ERR14                       ; Inputs power supply ET200SP fault
;
NOT I_PS_SAFETY                 ; Safety power supply
  AND CNCREADY                  ; CNC with no errors
  = ERR15                       ; Safety power supply fault
;
NOT I_PS_CNC                    ; CNC power supply
  AND CNCREADY                  ; CNC with no errors
  = ERR16                       ; CNC power supply fault
;
NOT I_PS_PPC                    ; Operator panel power supply
  AND CNCREADY                  ; CNC with no errors
  = ERR17                       ; Operator panel power supply fault
;
NOT I_PS_OUT_ET200SP            ; Output power supply ET200SP
  AND CNCREADY                  ; CNC with no errors
  = ERR18                       ; Output power supply ET200SP fault
;
NOT I_RPS_SYSTEM_OK             ; Drives power supply OK
  AND CNCREADY                  ; CNC with no errors
  = ERR20                       ; Drives power supply fault
;
;## Test of activated errors
;   ---------------------------
()                              ; Logic "1"
  = MOV ERR1 R_ERR1_32          ; Move ERR1-ERR32 to R_ERR1_32
  = MOV ERR33 R_ERR33_64        ; Move ERR33-ERR64 to R_ERR33_64
  = MOV ERR65 R_ERR65_96        ; Move ERR65-ERR96 to R_ERR65_96
  = MOV ERR97 R_ERR97_128       ; Move ERR97-ERR128 to R_ERR97_128
;
CPS R_ERR1_32 NE 0              ; There are errors between ERR1 and ERR32
  OR CPS R_ERR33_64 NE 0        ; There are errors between ERR33 and ERR64
  OR CPS R_ERR65_96 NE 0        ; There are errors between ERR65 and ERR96
  OR CPS R_ERR97_128 NE 0       ; There are errors between ERR97 and ERR128
  = M_PLC_ERROR                 ; Some PLC error activated
;
;## Management of the emergency input/output
;   ------------------------------------------
;
CPS R_DR_STATUS EQ 0            ; Power enable register
  AND NOT M_PLC_ERROR           ; Some error activated
  = O_EMERGEN                   ; Emergency from the CNC
;
I_PILZ_OK                       ; Condiciones de rearme OK
  AND _ALARM                    ; Hard-soft CNC ready
  AND NOT M_PLC_ERROR           ; Some error activated
  AND CPS R_DR_STATUS EQ 0      ; Power enable register
  = _EMERGEN                    ; Emergency to the CNC.
  = M_EMERGEN                   ; Emergency from the CNC
;
M_EMERGEN                       ; Emergency to the CNC
  AND CPS R_DR_NOT_POWER EQ 0   ; Drives without power
  AND I_POWER_ON                ; Power on
  = M_MACHINE_POWER             ; Machine with power
;
M_EMERGEN                       ; Emergency from the CNC
  AND (NOT M_MACHINE_POWER      ; Machine with power
  AND CLK400                    ; Impulse train 400 ms
  OR M_MACHINE_POWER)           ; Machine with power
  = O_LED_POWER_ON              ; Machine with power on LED azul
;
NOT M_MACHINE_POWER             ; Machine with power
  = MSG1                        ; Machine without power
;
NOT M_MACHINE_POWER             ; Machine with power
  = B0R_FEEDHOLC1               ; FEEDHOLDC1, machine without power
  = B0R_STARTC1                 ; No START, machine without power
  = B0R_AUXENDC1                ; AUXEND because machine has not power
  = B0R_XFERINHC1               ; Reading locked up, machine without power
;
END
