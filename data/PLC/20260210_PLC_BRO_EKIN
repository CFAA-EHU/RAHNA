  AND NOT M_TUNE_MODE           ; Tune up mode
  = B1R_INHIBITC                ; Particular table axis feedhold
;
;   ************** TABLE AXIS CONTROL *******************************************
;
()                              ; Logic '1'
  = M_TABLE_CONNECTED           ; Table axis connected
;
I_TABLE_UNLOCKED                ; Table axis unlocked detector
  AND NOT I_TABLE_LOCKED        ; Table axis locked detector
  AND I_TABLE_LOCK_PRESS        ; Table axis locked pressure
  = TG2 150 500                 ; Delay table axis unlocked
;
T150                            ; Delay table axis unlocked
  = M_TABLE_UNLOCKED            ; Confirmation table axis unlocked
;
I_TABLE_LOCKED                  ; Table axis locked detector
  AND NOT I_TABLE_UNLOCKED      ; Table axis unlocked detector
  AND NOT I_TABLE_LOCK_PRESS    ; Table axis locked pressure
  = TG2 151 500                 ; Delay table axis locked
;
T151                            ; Delay table axis locked
  = M_TABLE_LOCKED              ; Confirmation table axis locked
;
M_M11_C1                        ; M11: Table axis alive
  = SET M_TABLE_TORQUE          ; Table axis alive
;
M_M10_C1                        ; M10: Table axis dead
  OR PARKEDC                    ; Table axis parked
  = RES M_TABLE_TORQUE          ; Table axis alive
;
NOT M_TABLE_TORQUE              ; Table axis alive
  AND NOT PARKEDC               ; Table axis parked
  = DEADC                       ; Table axis blend not applied
;
M_TABLE_TORQUE                  ; Table axis alive
  AND NOT T153                  ; display timing MSG129
  = TG2 152 600000              ; Display timing MSG129
;
T152                            ; Display timing MSG129
  = MSG129                      ; INDEXER:Table axis alive
  = TG2 153 60000               ; Display timing MSG129
;
M_CY1                           ; First cycle scan
  AND NOT M_TABLE_CONNECTED     ; Table axis connected
  = M_TABLE_PARK_CY1            ; Park table axis in first cycle
;
M_CY1                           ; First cycle scan
  AND M_TABLE_CONNECTED         ; Table axis connected
  = M_TABLE_UNPARK_CY1          ; Unpark table axis in first cycle
;
DFU PARKC                       ; Park table axis via CNC
  OR M_TABLE_PARK_CY1           ; Park table axis in first cycle
  OR NOT M_TABLE_CONNECTED      ; Table axis connected
  = SET M_TABLE_PARKED          ; Request to park table axis
;
DFU UNPARKC                     ; Unpark table axis via CNC
  OR M_TABLE_UNPARK_CY1         ; Unpark table axis in first cycle
  = RES M_TABLE_PARKED          ; Request to park table axis
;
M_TABLE_PARKED                  ; Request to park table axis
  AND NOT DRENAC                ; Drive enable via SERCOS table axis
  AND NOT SPENAC                ; Table axis enable via SERCOS
  AND CPS R_DRST_C NE 3         ; Table axis drive disabled
  = PARKEDC                     ; Table axis parked
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_DR_NOT_POWER_C      ; Table axis without power
  AND NOT PARKEDC               ; Table axis parked
  AND NOT UNPARKC               ; Activate table axis
  AND NOT PARKC                 ; Park Table axis via CNC
  AND NOT ERR154                ; Error Maximum table axis unlocking time
  AND (ENABLEC                  ; Table axis in motion
  OR M_TABLE_TORQUE)            ; Table axis alive
  = M_TABLE_UNLOCK              ; Unlock table axis, moving permission
;
(M_TABLE_UNLOCKED               ; Confirmation table axis unlocked
  OR NOT M_TABLE_LOCKED)        ; Confirmation table axis locked
  AND M_TABLE_UNLOCK            ; Unlock table axis, moving permission
  AND NOT M_DR_NOT_POWER_C      ; Table axis without power
  AND NOT PARKEDC               ; Table axis parked
  AND NOT UNPARKC               ; Activate table axis
  AND NOT PARKC                 ; Table axis parked
  AND NOT LOPENC                ; Table controlled by CNC
  AND NOT M_TABLE_PARKED        ; Request to park table axis
  AND M_AXES_ENABLE             ; Axes enable permission
  = SERVOCON                    ; Table axis servo active
  = SPENAC                      ; Table axis enable via SERCOS
  = TG3 154 300                 ; Table axis drive disable delay
;
T154                            ; Table axis drive disable delay
  = DRENAC                      ; Drive enable table axis via SERCOS
  = TG2 155 3000                ; Maximum time table axis without torque
;
T155                            ; Maximum time table axis without torque
  AND SPENAC                    ; Table axis enable via SERCOS
  AND NOT M_DR_TORQUE_C         ; Table axis drive with torque
  = ERR213                      ; Error Table axis drive without torque
;
(DRENAC                         ; Drive enable table axis via SERCOS
  OR M_TABLE_XFERINH            ; Aux axis locked xferinh
  AND MATCHC)                   ; C axis in Hirth position
  AND NOT M_TABLE_TORQUE        ; Table axis alive
  AND NOT M_TABLE_LOCKED        ; Table axis locked
  = M_TABLE_XFERINH             ; Aux axis locked xferinh
;
M_TABLE_XFERINH                 ; Aux axis locked xferinh
  = B5R_XFERINHC1               ; Reading locked up, table axis is dead
;
M_TABLE_UNLOCK                  ; Unlock table axis, moving permission
  AND NOT M_TABLE_UNLOCKED      ; Confirmation table axis unlocked
  OR M_TABLE_LOCKED             ; Confirmation table axis locked
  = B5R_INHIBITC                ; Particular table axis feedhold
;
M_TABLE_UNLOCK                  ; Unlock table axis, moving permission
  AND M_HYD_PUMP_ON             ; Hydraulic group motor running
  = O_TABLE_UNLOCK              ; Unlock table axis
;
NOT M_TABLE_UNLOCK              ; Unlock table axis, moving permission
  AND MATCHC                    ; C axis in Hirth position
  AND NOT M_TABLE_LOCKED        ; Confirmation table axis locked
  AND M_HYD_PUMP_ON             ; Hydraulic group motor running
  = O_TABLE_LOCK                ; Lock table axis
;
O_TABLE_UNLOCK                  ; Unlock table axis
  AND NOT M_TABLE_UNLOCKED      ; Confirmation table axis unlocked
  = MSG125                      ; Waiting for table axis to be unlocked
  = TG2 156 10000               ; Maximum table axis unlock time
;
T156                            ; Maximum table axis unlock time
  = SET M_TABLE_UNLOCK_FAULT    ; Error maximum table axis unlocking
;
DFU M_TABLE_UNLOCK_FAULT        ; Error maximum table axis unlocking
  = SET ERR154                  ; Error Maximum table axis unlocking time
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT PARKEDC               ; Table axis parked
  AND NOT M_TABLE_UNLOCK        ; unlock table axis, moving permission
  AND NOT M_TABLE_LOCKED        ; Confirmation table axis locked
  = MSG126                      ; Waiting for table axis unlocking pressure
  = TG2 157 6000                ; Maximum table axis locking time
;
T157                            ; Maximum table axis locking time
  = SET M_TABLE_LOCK_FAULT      ; Error maximum table axis locking
;
DFU M_TABLE_LOCK_FAULT          ; Error maximum table axis locking
  = SET ERR155                  ; Error maximum table axis locking time
;
RESETOUT                        ; Reset CNC
  = RES ERR154                  ; Error maximum table axis unlocking time
  = RES ERR155                  ; Error maximum table axis locking time
  = RES M_TABLE_LOCK_FAULT      ; Error maximum table axis locking
;
END
;
;-------------------------------------------------------------------------
;                         Z-Z1 GANTRY
;-------------------------------------------------------------------------
;
; To correct a difference in dimensions between Z and Z1, the difference
; (DIFFCOMPZ) must be smaller than R_MAXDIFF (MAXCOUPE) in mm.
;
; Homed the Z and Z1 axes
;     1.- Autom?ticamente al finalizar la referencia del eje Z maestro (*)
;
;  (*) NOTA: El par?metro (OEM) MTB.P10 activa la opci?n del punto 1
;
; Si la diferencia de cotas es > de R_MAXDIFF mm tenemos 2 opciones:
;    Opci?n 1: Si el paralelismo esta bien corregir el REFVALUE
;    Opci?n 2: Desacoplar ejes y corregir paralelismo
;
; Si cae la se?al SERVOZON, se anula el error de seguimiento del eje esclavo.
; Si se anula el Gantry no se puede referenciar el eje Z
; M96: Permite mover el eje Z, una vez referenciado, sin paralelismo
;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;
;*************************************************************************
;                         INPUT RESOURCES
;*************************************************************************
;
; M_MACHINE_POWER               ; Machine with power
; M_DR_TORQUE_Z                 ; Z drive with torque
; M_DR_TORQUE_Z1                ; Z1 drive with torque
; M_GANTRY_ON_Z                 ; Gantry active on Z axis
; M_GANTRYOFF                   ; CNC decouples the gantry axis
; M_M96_C1                      ; M96: Enable Z-axis movements without parallelism
; M_MANUALC1                    ; Channel C1 in manual mode
; M_ZERO                        ; CNC in homing mode
; ENABLEZ                       ; Z axis in movement
; ENABLEZ1                      ; Z1 axis in movement
; SERVOZON                      ; Active Z axis servo
; SERVOZ1ON                     ; Active Z1 axis servo
; REFPOINZ                      ; Z axis homing has been made
; REFPOINZ1                     ; Z1 axis homing has been made
; MAXDIFFZ                      ; CNC cannot correct the position difference
; RESETOUT                      ; Reset from operator panel
; B9KEYBD1                      ; Operator panel pushbutton Z1+
; B10KEYBD1                     ; Operator panel pushbutton Z1-
; R_WARNCOUPE                   ; Maximum difference for warning (WARNCOUPE)
; R_MAXDIFF                     ; Maximum difference allowed (MAXCOUPE)
;
;*************************************************************************
;                         OUTPUT RESOURCES
;*************************************************************************
; GANTRYOFFZ1                   ; CNC decouples the gantry Z-Z1 axes
; DIFFCOMPZ                     ; Correction of the parallelism between Z-Z1
; AXISPOSZ1                     ; Manual movement request Z1+
; B9KEYLED1                     ; Z1+ operator panel LEDs
; AXISNEGZ1                     ; Manual movement request Z1-
; B10KEYLED1                    ; Z1- operator panel LEDs
; DROZ                          ; Z axis as DRO mode
; DROZ1                         ; Z1 axis as DRO mode
; MSG14                         ; GANTRY: Difference between Z-Z1 > R_WARNCOUPE (mm)
; MSG15                         ; GANTRY: Non coupled Z-Z1 axes
; MSG16                         ; GANTRY: Disable  Z axis movements (M96)
; MSG17                         ; GANTRY: Automatic correction of parallelism cancelled
; ERR48                         ; GANTRY: Difference between Z-Z1 > MAXCOUPE (mm)
; ERR30                         ; GANTRY: There is no Z axis homing permission
;
;*************************************************************************
;*************************************************************************
;                         INTERNAL RESOURCES
;*************************************************************************
; M_CNCRD_SYN                   ; Mark to read synchronous CNC variables
; M_REFZ                        ; Z-Z1 axes in homing mode
; M_REFPOINZ                    ; Gantry axis homing has been made
; M_GANTRY_MAXDIFFZ             ; Difference between Z-Z1 > MAXCOUPE (mm)
; M_GANTRY_BYPASZ               ; Enable Z-axis movements without parallelism
; R_POSZ                        ; Z-axis position reading
; R_POSZ1                       ; Z1-axis position reading
; R_POS_DIFF                    ; Position difference (mm) between Z and Z1
;
;*************************************************************************
;                         EXCEPTIONS
;*************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 210
;
;#END EXCEPTIONS

SUB GANTRY_Z
;
M_GANTRYOFF                     ; CNC decouples the gantry axis
  = GANTRYOFFZ1                 ; CNC decouples the gantry Z-Z1 axes
  = MOV $F3800000 KEYDIS3       ; Movement selector
;
NOT M_GANTRYOFF                 ; CNC decouples the gantry axis
  = MOV R_NULL KEYDIS3          ; Movement selector
;
()                              ; Logic "1"
  = CNCRD(A.POS.Z,R_POSZ,M_CNCRD_SYN)  ; Z-axis position reading
  = CNCRD(A.POS.Z1,R_POSZ1,M_CNCRD_SYN); Z1-axis position reading
  = SBS R_POSZ R_POSZ1 R_POS_DIFF ; Position difference (mm) between Z and Z1
;
B31R_POS_DIFF                   ;Sign bit
  = MLS -1 R_POS_DIFF R_POS_DIFF; Change sign
;
M_ZERO                          ; CNC in homing mode
  AND (ENABLEZ                  ; Z axis in movement
  OR ENABLEZ1)                  ; Z1 axis in movement
  = M_REFZ                      ; Z-Z1 axes in homing mode
;
M_REFZ                          ; Z-Z1 axes in homing mode
  OR CPS R_POS_DIFF GT R_MAXDIFF ; Difference between Z and Z1 > MAXCOUPE (mm)
  OR NOT SERVOZON               ; Active Z axis servo
  OR NOT SERVOZ1ON              ; Active Z1 axis servo
  = RES DIFFCOMPZ               ; Correction of the parallelism between Z-Z1
;
NOT M_REFZ                      ; Z-Z1 axes in homing mode
  AND REFPOINZ                  ; Z axis homing has been made
  AND REFPOINZ1                 ; Z1 axis homing has been made
  = M_REFPOINZ                  ; Gantry axis homing has been made
;
M_GANTRY_ON_Z                   ; Gantry active on Z axis
  AND M_REFPOINZ                ; Gantry axis homing has been made
  AND SERVOZON                  ; Active Z axis servo
  AND SERVOZ1ON                 ; Active Z1 axis servo
  AND CPS R_POS_DIFF GE R_WARNCOUPE ; Difference between Z and Z1 >= R_WARNCOUPE (mm)
  AND CPS R_POS_DIFF LE R_MAXDIFF ; Difference between Z and Z1 <= MAXCOUPE (mm)
  = MSG14                       ; GANTRY: Difference between Z-Z1 > R_WARNCOUPE (mm)
;
NOT M_GANTRY_ON_Z               ; Gantry active on Z axis
  OR M_GANTRYOFF                ; CNC decouples the gantry Z-Z1 axes
  = MSG15                       ; GANTRY: Non coupled Z-Z1 axes
;
MSG15                           ; GANTRY: Non coupled Z-Z1 axes
  AND NOT M_MAN_MDIC1           ; CNC in Jog and MDI modes
  = B10R_STARTC1                ; No START, GANTRY: Non coupled Z-Z1 axes
;
M_GANTRY_ON_Z                   ; Gantry active on Z axis
  AND M_REFPOINZ                ; Gantry axis homing has been made
  AND SERVOZON                  ; Active Z axis servo
  AND SERVOZ1ON                 ; Active Z1 axis servo
  AND (CPS R_POS_DIFF GT R_MAXDIFF ; Difference between Z and Z1 > MAXCOUPE (mm)
  OR MAXDIFFZ)                  ; CNC cannot correct the position difference
  = M_GANTRY_MAXDIFFZ           ; Difference between Z-Z1 > MAXCOUPE (mm)
;
M_M96_C1                        ; M96: Enable Z-axis movements without parallelism
  AND M_GANTRY_MAXDIFFZ         ; Difference between Z-Z1 > MAXCOUPE (mm)
  = SET M_GANTRY_BYPASZ         ; Enable Z-axis movements without parallelism
;
M_GANTRY_MAXDIFFZ               ; Difference between Z-Z1 > MAXCOUPE (mm)
  AND NOT M_GANTRY_BYPASZ       ; Enable Z-axis movements without parallelism
  = MSG16                       ; GANTRY: Disable  Z axis movements (M96)
;
M_GANTRY_MAXDIFFZ               ; Difference between Z-Z1 > MAXCOUPE (mm)
  AND NOT M_ZERO                ; CNC in homing mode
  AND NOT M_GANTRY_BYPASZ       ; Enable Z-axis movements without parallelism
  AND ENABLEZ                   ; Z axis in movement
  = SET ERR48                   ; GANTRY: Difference between Z-Z1 > MAXCOUPE (mm)
;
RESETOUT                        ; Reset from operator panel
  OR NOT M_GANTRY_ON_Z          ; Gantry active on Z axis
  OR CPS R_POS_DIFF LE 200      ; Difference between Z and Z1 <= 0.02 mm
  OR DFD M_MANUALC1             ; Channel C1 in manual mode
  = RES M_GANTRY_BYPASZ         ; Enable Z-axis movements without parallelism
  = RES ERR48                   ; Diferencia entre Z-Z1 > MAXCOUPE (mm)
;
M_ZERO                          ; CNC in homing mode
  AND NOT M_GANTRY_ON_Z         ; Gantry active on Z axis
  = ERR30                       ; GANTRY: There is no Z axis homing permission
;
NOT SERVOZON                    ; Active Z axis servo
  = DROZ                        ; Z axis as DRO mode
;
NOT SERVOZ1ON                   ; Z1 servo active
  = DROZ1                       ; Z1 axis as DRO mode
;
M_GANTRY_DIFFCOMPZ              ; Automatic parallelism correction
  AND M_GANTRY_ON_Z             ; Gantry active on Z axis
  AND M_REFPOINZ                ; Gantry axis homing has been made
  AND NOT CPS R_POS_DIFF GT R_MAXDIFF ; Difference between Z and Z1 > MAXCOUPE (mm)
  AND M_DR_TORQUE_Z             ; Z drive with torque
  AND M_DR_TORQUE_Z1            ; Z1 drive with torque
  AND NOT M_GANTRYOFF           ; CNC decouples the gantry axis
  AND NOT INHIBITZ
  = SET DIFFCOMPZ               ; Correction of the parallelism between Z-Z1
;
NOT M_GANTRY_DIFFCOMPZ          ; Automatic parallelism correction
  = MSG17                       ; GANTRY: Automatic correction of parallelism cancelled
;
END
;
;------------------------------------------------------------------------------
;                         GUIDE WAY LUBRICATION
;------------------------------------------------------------------------------
;******************************************************************************
;
; 1.-This subroutine contemplates diferents types of lubrication:
;    -->Lubrication by CNC distance
;    -->Lubrication by time
;    -->Lubrication under request.
; 2.-It activates the lubrication by the first condition met and resets all.
; 3.-The distance values are set by machine parameters and the time is validated
;    in the OPTIONS subroutine
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; I_LUC400_FAULT                ; LUC 400 Lubrication failure
; BD1_LUB_REQUEST               ; Lubrication request
; M_MACHINE_POWER               ; Machine with power
; M_MANUALC1                    ; CNC in manual modes
; M_RESET_C1                    ; General reset
; LUBRZ                         ; Lube distance Z reached (CNC)
; ENABLEZ                       ; Z axis in movement
; RAPID                         ; CNC in G0 feed
; R_TIME_PULSE_LUB_S            ; Extra lubrication time with pressure (sec.)
; R_TIME_PULSE_LUB_MS           ; Extra lubrication time with pressure (ms.)
; R_TIME_PAUSE_LUB_S            ; Pause between lubrications (seconds)
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; O_LUB_GUIDES                  ; Activate way lubrication
; B5R_STARTC1                   ; No START, lubrication failure
; LUBRENAZ                      ; Enable Z lubrication distance by CNC
; LUBROKZ                       ; Reset Z lubrication distance (CNC)
; MSG32                         ; E1: Empty indicator
; MSG33                         ; E2: Overcurrent
; MSG34                         ; Way lubrication LUC400 failure
; MSG141                        ; Way lubrication pressure failure
; MSG142                        ; Way lubrication pressure switch stuck
; MSG145                        ; Way Lubrication thermal switch failure
;
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
; M_LUB_THS                     ; Lubrication thermal switch
; M_LUB_PRESSURE                ; Way lubrication pressure
; M_LUB_LEVEL                   ; Way lubrication oil level
; M_LUB_REQUEST                 ; Way lubrication request memory
; M_LUB_GUIDES                  ; Activate way lubrication guides
; M_LUB_PRESS_FAILURE           ; Way lubrication pressure failure
; M_LUB_CONDITIONS              ; Lub. conditions
; B0R_LUBRICATION               ; Request lubrication by machine power-up
; B1R_LUBRICATION               ; Request lubrication by distance (CNC)
; B2R_LUBRICATION               ; Request lubrication by time
; C021                          ; Counter of seconds between lubrications
; T021                          ; Extra time for lubrication with pressure
; T022                          ; Time to reach pressure
; T023                          ; Delay failure, lub. pressure switch stuck
; T024                          ; Delay way lubrication level failure
; T025                          ; Delay Error lubrication pressure switch stuck
; T026                          ; Delay Error lubrication pressure failure
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 305
;
;#END EXCEPTIONS
;
SUB GUIDES_LUBRICATION_LUC400
;
NOT I_LUC400_FAULT              ; LUC 400 Lubrication failure
 = M_LUC400_FAULT               ; LUC 400 Lubrication failure
;
NOT MSG32                       ; E1: Empty indicator
  AND NOT MSG33                 ; E2: Overcurrent
  AND M_MACHINE_POWER           ; Machine with power
  = M_LUB_CONDITIONS            ; Lub. conditions
;
M_MACHINE_POWER                 ; Machine with power
  = LUBRENAZ                    ; Enable Z lubrication distance by CNC
;
LUBRZ                           ; Lube distance Z reached (CNC)
  = SET B1R_LUBRICATION         ; Request lubrication by distance (CNC)
;
ENABLEZ                         ; Z axis in movement
  AND NOT M_LUB_GUIDES          ; Activate way lubrication
  AND (DFU CLK1000              ; Flank every second
  OR DFD CLK1000)               ; Flank every second
  = CUP 010                     ; Counter of seconds between lubrications
;
CPS C010 GE 60                  ; From seconds to minutes
  = CUP 011                     ; Counter of minutes between lubrications
  = CPR 010 0                   ; Reset counter of seconds
;
CPS C011 GE 60                  ; From minutes to hours
  = CUP 012                     ; Counter of hours between lubrications
  = CPR 011 0                   ; Reset counter of minutes
;
CPS C012 GE R_TIME_PAUSE_LUB    ; Pause between lubrications done
  = SET B2R_LUBRICATION         ; Request lubrication by time
  = CPR 012 0                   ; Reset counter of hours
;
M_M95_C1                        ; Aux. lubrication filling function
  AND NOT M_LUB_CYCLE           ; Lubrication cycle
  = SET M_LUB_FILL              ; Filling function
  = MOV 0 R_LUB_SETUP
;
CPS R_LUB_SETUP GE 10
  OR NOT M_LUB_CONDITIONS       ; Lub. conditions
  OR DFD M_LUB_CYCLE            ; Lub. cycle down flank
  = MOV 0 R_LUB_SETUP
  = RES M_LUB_FILL              ; Filling function
;
(M_LUB_FILL                     ; Filling function
  OR M_SM_LUB_ON)               ; Screen monitoring: Lubrication ON
  AND NOT M_LUB_CYCLE           ; Lubrication cycle
  AND M_LUB_CONDITIONS          ; Lub. conditions
  = B3R_LUBRICATION             ; Request lubrication manual
;
CPS R_LUBRICATION NE 0          ; Request to lubricate machine
  AND NOT MSG34                 ; Way lubrication LUC400 failure
  = MOV 1 R_LUB_CYCLE           ; Request the first pulse of lubrication of the guides
  = MOV 0 R_LUBRICATION         ; Cancel lubrication requests
  = ADS R_LUB_SETUP 1 R_LUB_SETUP
;
B0R_LUB_CYCLE                   ; Initial lubrication of the guides
  = TG2 021 15000               ; Initial timing of the lubrication cycle
;
B0R_LUB_CYCLE                   ;
  AND T021                      ; Initial timing of the lubrication cycle
  = RL1 R_LUB_CYCLE 1 R_LUB_CYCLE ; Pause between lubrications pulses
;
B1R_LUB_CYCLE                   ; Request the first pulse of lubrication of the guides
  = M_LUB_PULSE_1               ; Way lubrication request first pulse
;
B1R_LUB_CYCLE                   ; Request first pulse lubrication of the guides
  AND M_LUB_PULSE_1             ; Way lubrication request first pulse
  = TG2 022 2000                ; Amount of lubrical pulse 0.15 cm3
;
B1R_LUB_CYCLE                   ; Request first pulse lubrication of the guides
  AND T022                      ; Amount of lubrical pulse 0.15 cm3
  = RL1 R_LUB_CYCLE 1 R_LUB_CYCLE ; Pause between lubrications pulses
;
B2R_LUB_CYCLE                   ; Pause between lubrications pulses
  = TG2 023 15000               ; Pause between lubrications pulses
;
T023                            ; Pause between lubrications pulses
  = RL1 R_LUB_CYCLE 1 R_LUB_CYCLE ; Request second pulse lubrication of the guides
;
B3R_LUB_CYCLE                   ; Request second pulse lubrication of the guides
  = M_LUB_PULSE_2               ; Way lubrication request second pulse
;
B3R_LUB_CYCLE                   ; Request second pulse lubrication of the guides
  AND M_LUB_PULSE_2             ; Way lubrication request second pulse
  = TG2 024 2000                ; Amount of lubrical pulse 0.15 cm3
;
B3R_LUB_CYCLE                   ; Request second pulse lubrication of the guides
  AND T024                      ; Amount of lubrical pulse 0.15 cm3
  = MOV 0 R_LUB_CYCLE           ; End of lubtications cycle
;
M_LUB_PULSE_1                   ; Way lubrication request first pulse
  OR M_LUB_PULSE_2              ; Way lubrication request second pulse
  = O_LUB_GUIDES                ; Activate way lubrication guides
  = TG3 028 14000               ; Delay post-Lubrication cycle
  = LD1_LUB_REQUEST             ; Lubrication request
;
CPS R_LUB_CYCLE NE 0            ; Lubrication cycle
  = M_LUB_CYCLE                 ; Lubrication cycle
;
DFD M_LUB_CYCLE                 ; Lubrication cycle
  = LUBROKZ                     ; Reset X lubrication distance (CNC)
  = CPR 010 0                   ; Reset counter of seconds
  = CPR 011 0                   ; Reset counter of minutes
  = CPR 012 0                   ; Reset counter of hours
;
M_LUC400_FAULT                  ; LUC 400 Lubrication failure
  AND NOT T028                  ; Delay post-Lubrication cycle
  AND M_MACHINE_POWER           ; Machine with power
  = TG2 025 750                 ; Delay to identify fault
  = TG2 026 2000                ; Delay to identify fault
;
T025                            ; Delay to identify fault
  = SET M_LUC400_FAULT_E1       ; E1: Empty indicator
;
M_LUC400_FAULT_E1               ; E1: Empty indicator
  AND T026                      ; Delay to identify fault
  = RES M_LUC400_FAULT_E1       ; E1: Empty indicator
;
M_LUC400_FAULT_E1               ; E1: Empty indicator
  = TG2 027 3000                ; Delay to identify fault
;
T027                            ; Delay to identify fault
  = SET MSG32                   ; E1: Empty indicator
;
T026                            ; Delay to identify fault
  = SET MSG33                   ; E2: Overcurrent
;
RESETOUTC1                      ; CNC reset
  = RES MSG32                   ; E1: Empty indicator
  = RES MSG33                   ; E2: Overcurrent
;
MSG32                           ; E1: Empty indicator
  OR MSG33                      ; E2: Overcurrent
  = B5R_STARTC1                 ; No START, lubrication failure
;
END
