;
SUB BROACH_COOLANT
;
I_COOL_TRANSF_THS               ; Coolant transfer motor circuit breaker
  = M_COOL_TRANSF_THS           ; Coolant transfer motor circuit breaker
;
I_COOL_MAIN_THS                 ; Coolant motor main circuit breaker
  = M_COOL_MAIN_THS             ; Coolant motor main circuit breaker
;
I_COOL_TRANSFER_ON              ; Coolant transfer motor on
  = M_COOL_TRANSFER_ON          ; Coolant transfer motor on
;
I_COOL_MAIN_ON                  ; Coolant motor main on
  = M_COOL_MAIN_ON              ; Coolant motor main on
;
I_COOL_FLOW                     ; Coolant flow
  = TG2 128 3000                ; Delay Coolant flow
;
T128                            ; Delay Coolant flow
  = M_COOL_FLOW                 ; Coolant flow
;
I_COOL_TANK_MIN                 ; Coolant tank level minimum
  = M_COOL_TANK_MIN             ; Coolant tank level minimum
;
M_DOOR_CLOSED                   ; Door closed
  AND M_COOL_TRANSF_THS         ; Coolant transfer motor circuit breaker
  AND M_COOL_MAIN_THS           ; Coolant motor main circuit breaker
  AND NOT MSG29                 ; Coolant tank level minimum failure
  AND M_MACHINE_POWER           ; Machine with power
  = M_COOL_MAIN_COND            ; Coolant motor main condition
;
M_M8_C1                         ; M8: Coolant
  AND NOT M_COOL_MAIN           ; Request for coolant
  OR M_SM_COOLANT_ON            ; Screen monitoring: Coolant ON
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = SET M_COOL_MAIN             ; Coolant motor main ON
;
DFU M_COOL_MAIN                 ; Coolant motor main ON
  AND NOT M_COOL_MAIN_COND      ; Coolant motor main condition
  AND NOT M_TUNE_MODE           ; Tune up mode
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = SET ERR119                  ; Coolant motor main not condition
;
M_M9_C1                         ; M9: Cancel coolant
  OR M_SM_COOLANT_OFF           ; Screen monitoring: Coolant OFF
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  OR NOT M_COOL_MAIN_COND       ; Coolant motor main conditionn
  OR M_RESET_C1                 ; General reset
  OR ERR120                     ; Broach coolant motor not operational
  OR ERR121                     ; Coolant transfer motor not operational
  OR ERR122                     ; Frame cleanin motor not operational
  = RES M_COOL_MAIN             ; Request for coolant
;
M_COOL_MAIN                     ; Request for coolant
  AND DFU M_BROACHING_CYCLE     ; Broaching cycle
  = SET M_COOL_FLOW_AUX         ; Aux. coolant flow
;
NOT M_COOL_MAIN                 ; Request for coolant
  OR M_COOL_FLOW                ; Coolant flow
  OR NOT M_MACHINE_POWER        ; Machine with power
  = RES M_COOL_FLOW_AUX         ; Aux. coolant flow

M_COOL_FLOW_AUX                 ; Aux. coolant flow
  = B2R_AUXENDC1                ; AUXEND: Coolant flow
  = MSG30                       ; Coolant flow failure
;
M_COOL_MAIN                     ; Request for frame cleaning
  AND M_COOL_MAIN_COND          ; Frame cleaning condition
  = O_COOL_MAIN                 ; Coolant motor main
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_TUNE_MODE           ; Tune up mode
  AND (O_COOL_MAIN              ; Coolant motor main
  AND NOT M_COOL_MAIN_ON        ; Coolant motor main on
  OR NOT O_COOL_MAIN            ; Coolant motor main
  AND M_COOL_MAIN_ON)           ; Coolant motor main on
  = TG2 130 2000                ; Delay coolant motor main monitoring
;
T130                            ; Delay coolant motor main monitoring
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = SET ERR120                  ; Coolant motor main does not work properly
;
M_COOL_MAIN                     ; Request for coolant motor main
  AND M_COOL_MAIN_COND          ; Coolant motor main condition
  = TG3 131 5000                ; Delay coolant transfer motor switch-off
;
T131                            ; Delay coolant transfer motor switch-off
  = M_COOL_TRANSFER             ; Coolant transfer motor start
;
M_COOL_TRANSFER                 ; Coolant transfer motor start
  = O_COOL_TRANSFER             ; Coolant transfer motor start
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_TUNE_MODE           ; Tune up mode
  AND (O_COOL_TRANSFER          ; Coolant transfer motor start
  AND NOT M_COOL_TRANSFER_ON    ; Coolant transfer motor on
  OR NOT O_COOL_TRANSFER        ; Coolant transfer motor start
  AND M_COOL_TRANSFER_ON)       ; Coolant transfer motor on
  = TG2 132 2000                ; Delay coolant transfer motor monitoring
;
T132                            ; Delay coolant transfer motor monitoring
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = SET ERR121                  ; Coolant transfer motor does not work properly
;
M_COOL_MAIN                     ; Request for broach coolant
  AND M_COOL_MAIN_COND          ; Broach coolant condition
  AND NOT ENABLEZ               ; Z axe in moviment
  AND NOT M_BROACHING_CYCLE     ; Broaching cycle
  = O_FRAME_CLEAN               ; Activate frame cleaning
;
M_COOL_MAIN                     ; Request for broach coolant
   AND NOT M_DOOR_CLOSED        ; Door closed
  = MSG26                       ; Broach coolant impossible due to open door
;
M_COOL_MAIN                     ; Request for broach coolant
  AND NOT M_COOL_TRANSF_THS     ; Coolant transfer motor circuit breaker
  = SET MSG27                   ; Coolant transfer motor thermal switch failure
;
M_COOL_MAIN                     ; Request for broach coolant
  AND NOT M_COOL_MAIN_THS       ; Coolant motor main circuit breaker
  = SET MSG28                   ; Coolant motor main thermal switch failure
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_COOL_TANK_MIN       ; Coolant tank level minimum
  AND NOT M_TUNE_MODE           ; Tune up mode
  AND NOT M_BROACHING_REPOS     ; Post-Emergency Gantry Repositioning
  = TG2 133 30000               ; Delay coolant tank level minimum failure
;
T133                            ; Delay coolant tank level minimum failure
  = SET MSG29                   ; Coolant tank level minimum failure
;
RESETOUTC1                      ; CNC reset
  = RES MSG27                   ; Coolant transfer motor thermal switch failure
  = RES MSG28                   ; Coolant motor main thermal switch failure
  = RES MSG29                   ; Coolant tank level minimum failure
  = RES ERR119                  ; Coolant motor main not condition
  = RES ERR120                  ; Broach coolant motor not operational
  = RES ERR121                  ; Coolant transfer motor not operational
  = RES ERR122                  ; Frame cleanin motor not operational
;
(MSG27                          ; Broach coolant thermal switch failure
  OR MSG28)                     ; Coolant motor main thermal switch failure
  AND NOT M_TUNE_MODE           ; Tune up mode
  = B6R_STARTC1                 ; START: Ext. coolant thermal switch failure
;
END
