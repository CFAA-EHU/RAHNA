;-------------------------------------------------------------------------
;                       CHIP CONVEYOR
;-------------------------------------------------------------------------
;*************************************************************************
;
; Chip conveyor only rotates in one direction.
; Magnetic roller. Works in conjunction with coolant transfer.
;
; 1.- Programming via CNC:
;    M92: Activate chip conveyor
;    M93: Stop chip conveyor
; 2.- Handled from operator panel
;    BD1_CHIP_CONVEYOR: Button to activate chip conveyor
;
;*************************************************************************
;                         INPUT RESOURCES
;*************************************************************************
;
; M_MACHINE_POWER               ; Machine with power
; M_COOL_TRANSFER               ; Coolant transfer motor start
; BD1_CHIP_CONVEYOR             ; Button to activate chip conveyor
; M_M92_C1                      ; Activate chip conveyor
; M_M93_C1                      ; Stop chip conveyor
;
;*************************************************************************
;                         OUTPUT RESOURCES
;*************************************************************************
;
; O_CHIP_CONVEYOR               ; Chip conveyor
; LD1_CHIP_CONVEYOR             ; LED Chip conveyor on
; MSG53                         ; Chip conveyor motor not operational
; MSG54                         ; Chip conveyor thermal switch failure
;
;*************************************************************************
;                         INTERNAL RESOURCES
;*************************************************************************
;
; M_CHIP_CONVEYOR_THS           ; Chip conveyor thermal switch
; M_CHIP_CONVEYOR_COND          ; Chip conveyor condition
; M_CHIP_CONVEYOR               ; Request for chip conveyor
;
;*************************************************************************
;                         EXCEPTIONS
;*************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 355
;
;#END EXCEPTIONS
;
SUB CHIP_CONVEYOR
;
I_CHIP_CONVEYOR_THS             ; Chip conveyor thermal switch
  = M_CHIP_CONVEYOR_THS         ; Chip conveyor thermal switch
;
I_CHIP_CONVEYOR_ON              ; Chip conveyor motor on
  = M_CHIP_CONVEYOR_ON          ; Chip conveyor motor on
;
M_CHIP_CONVEYOR_THS             ; Chip conveyor thermal switch
  AND M_MACHINE_POWER           ; Machine with power
  = M_CHIP_CONVEYOR_COND        ; Chip conveyor condition
;
(M_M92_C1                       ; M92: Activate chip conveyor
  OR DFU M_COOL_TRANSFER        ; Coolant transfer motor start
  OR M_SM_CHIP_ON)              ; Screen monitoring: Activate chip conveyor
  AND NOT M_CHIP_CONVEYOR       ; Request for chip conveyor
  AND M_CHIP_CONVEYOR_COND      ; Chip conveyor condition
  AND M_DOOR_CLOSED             ; Door closed
  = SET M_CHIP_CONVEYOR         ; Request for chip conveyor
;
M_M93_C1                        ; M93: Stop chip conveyor
  OR M_SM_CHIP_OFF              ; Screen monitoring: Stop chip conveyor
  OR DFD M_COOL_TRANSFER        ; Coolant transfer motor start
  OR NOT M_CHIP_CONVEYOR_COND   ; Chip conveyor condition
  OR MSG53                      ; Chip conveyor motor not operational
  = RES M_CHIP_CONVEYOR         ; Request for chip conveyor
;
M_CHIP_CONVEYOR                 ; Request for chip conveyor
  AND M_CHIP_CONVEYOR_COND      ; Chip conveyor condition
  = O_CHIP_CONVEYOR             ; Chip conveyor
;
M_MACHINE_POWER                 ; Machine with power
  AND (O_CHIP_CONVEYOR          ; Chip conveyor
  AND NOT M_CHIP_CONVEYOR_ON    ; Chip conveyor motor on
  OR NOT O_CHIP_CONVEYOR        ; Chip conveyor
  AND M_CHIP_CONVEYOR_ON)       ; Chip conveyor motor on
  = TG2 015 2000                ; Delay chip conveyor motor monitoring
;
T015                            ; Delay chip conveyor motor monitoring
  = SET MSG53                   ; Chip conveyor motor does not work properly
;
RESETOUTC1                      ; CNC reset
  = RES MSG53                   ; Chip conveyor motor does not work properly
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT M_CHIP_CONVEYOR_THS   ; Chip conveyor thermal switch
  = MSG54                       ; Chip conveyor thermal switch failure
;
END
