; I_DOOR_L_KEY_IN               ; Left door key in
; I_DOOR_R_KEY_IN               ; Right door key in
; I_DOOR_SC_KEY_IN              ; Interior scuttle key in
;
; I_DOOR_OPEN_PB                ; Door opening push-button
