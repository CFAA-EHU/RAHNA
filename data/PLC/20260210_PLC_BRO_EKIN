;------------------------------------------------------------------------------
;                         AXIS ENABLE
;------------------------------------------------------------------------------
;******************************************************************************
;
; 1.-It closes the SERVO loop of each axis, checking relevant conditions.
;   At the same time:
;       -->It deactivates the brake.
;       -->It sends SPENA to SP1 drive  (feedrate enable).
;       -->It sends DRENA to the drive (power enable).
; 2.-Once SPENA drops (feed enable) it is maintained for a while
;   until dropping DRENA (power enable), so the axis does not stop
;   by friction.
; 3.-It checks if there is a  request for dead axis.
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; M_MACHINE_POWER               ; Machine with power
; M_AXES_ENABLE                 ; Axes enable permission
; M_DR_TORQUE_Z                 ; Z drive with torque
; M_DR_TORQUE_Z1                ; Z1 drive with torque
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; O_Z_BRAKE                     ; Z brake
; O_Z1_BRAKE                    ; Z1 brake
; SERVOZON                      ; Z servo active
; SPENAZ                        ; Z enable via SERCOS
; DRENAZ                        ; Drive enable via SERCOS
; SERVOZ1ON                     ; Z1 servo active
; SPENAZ1                       ; Z1 enable via SERCOS
; DRENAZ1                       ; Drive enable via SERCOS
; ERR211                        ; Error Z drive without torque
; ERR212                        ; Error Z1 drive without torque
;
;******************************************************************************
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
;
; T002                          ; 300 ms delay to cancel DRENAZ
; T005                          ; 300 ms delay to cancel DRENAZ1
; T121                          ; Maximum time Z without torque
; T124                          ; Maximum time Z1 without torque
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 200
;
;#END EXCEPTIONS
;
SUB AXES_ENABLE
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT LOPENZ                ; Z controlled by CNC
  AND M_AXES_ENABLE             ; Axes enable permission
  = SERVOZON                    ; Z servo active
  = SPENAZ                      ; Z enable via SERCOS
  = TG3 002 300                 ; Delay for DRENAZ
;
T002                            ; 300 ms delay to cancel DRENAZ
  = DRENAZ                      ; Drive enable via SERCOS
  = TG2 121 3000                ; Maximum time Z without torque
;
T121                            ; Maximum time Z without torque
  AND SPENAZ                    ; Z enable via SERCOS
  AND NOT M_DR_TORQUE_Z         ; Z drive with torque
  AND M_AXES_ENABLE_AUX         ; Aux. Axis enable permission
  = ERR211                      ; Error Z drive without torque
;
M_MACHINE_POWER                 ; Machine with power
  AND SPENAZ                    ; Z enable via SERCOS
  AND M_DR_TORQUE_Z             ; Z drive with torque
  = M_Z_BRAKE                   ; Aux. Z brake
;
M_MACHINE_POWER                 ; Machine with power
  AND NOT LOPENZ1               ; Z1 controlled by CNC
  AND M_AXES_ENABLE             ; Axes enable permission
  = SERVOZ1ON                   ; Z1 servo active
  = SPENAZ1                     ; Z1 enable via SERCOS
  = TG3 005 300                 ; Delay for DRENAZ1
;
T005                            ; 300 ms delay to cancel DRENAZ1
  = DRENAZ1                     ; Drive enable via SERCOS
  = TG2 124 3000                ; Maximum time Z1 without torque
;
T124                            ; Maximum time Z1 without torque
  AND SPENAZ1                   ; Z1 enable via SERCOS
  AND NOT M_DR_TORQUE_Z1        ; Z1 drive with torque
  AND M_AXES_ENABLE_AUX         ; Aux. Axis enable permission
  = ERR212                      ; Error Z1 drive without torque
;
M_MACHINE_POWER                 ; Machine with power
  AND SPENAZ1                   ; Z1 enable via SERCOS
  AND M_DR_TORQUE_Z1            ; Z1 drive with torque
  = M_Z1_BRAKE                  ; Aux. Z1 brake
;
M_Z_BRAKE                       ; Aux. Z brake
  AND M_Z1_BRAKE                ; Aux. Z1 brake
  = O_PILZ_BRAKE                ; Pilz brake signal
;
I_BRAKE_Z_ENA                   ; Z axes brake enable
  = M_BRAKE_Z_ENA               ; Z axes brake enable
;
NOT M_BRAKE_Z_ENA               ; Z axes brake enable
  = B0R_INHIBITZ                ; INHIBITZ,Z axes brake enable
  = B0R_INHIBITZ1               ; INHIBITZ1,Z axes brake enable
;
END
