  OR NOT O_PAPER_FILTER         ; Paper filter motor on
  AND M_PAPER_FILTER_ON)        ; Paper filter motor running
  = TG2 059 2000                ; Delay paper filter engine monitoring
;
T059                            ; Delay paper filter engine monitoring
  = SET MSG59                   ; Paper filter motor does not work properly
;
