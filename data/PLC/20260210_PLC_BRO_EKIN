; INPOSZ                        ; Z axis in position
; INPOSC                        ; C axis in position
; INCYCLEC1                     ; CNC in execution
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; O_DOOR_F_LOW_UNLOCK           ; Front lower door unlock
; O_DOOR_F_UP_UNLOCK            ; Front upper door unlock
