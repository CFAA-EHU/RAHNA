;------------------------------------------------------------------------------
;                    MANAGEMENT OF CNC WORK MODES
;------------------------------------------------------------------------------
;******************************************************************************
;
;1.-Read some parameters to know the work mode
;   the machine is in:
;     Manual intervention in automatic (G200,G201)
;     Manual mode C1
;
;******************************************************************************
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; M_MACHINE_POWER               ; Machine with power
; MANUALC1                      ; CNC in manual modes
; SBOUTC1                       ; CNC in single-block mode
; RESETOUTC1                    ; CNC reset
; B11KEYBD2                     ; Homing key
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; M_MANUALC1                    ; CNC in manual modes
; M_MAN_MDIC1                   ; CNC in JOG and MDI mode
; M_MAN_INT_AUTO                ; CNC in manual intervention in automatic
; M_AUTO_INCYCLE                ; CNC in cycle in AUTOMAT mode
; M_TOOLINSP_C1                 ; CNC in tool inspection
; M_TOOLINSP_MDIC1              ; CNC in MDI tool inspection with open door
; M_REPOS_C1                    ; CNC in reposition
; M_ZERO                        ; CNC in homing mode
; LATCHM                        ; Axes not maintained
;
;******************************************************************************
;
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
;
; M_CNCRD_SYN                   ; Mark to read synchronous CNC variables
; R_INTMAN                      ; CNC in manual modes
; R_CNC_G200                    ; G200 active at the CNC
; R_CNC_G201                    ; G201 active at the CNC
; R_MAN_STATUS                  ; CNC status in manual mode
; R_MAN_STATUS_FILTER           ; CNC status in filtered manual mode
; R_AUTSTATUS                   ; CNC in automatic mode
; R_TOOLINSP_C1                 ; CNC in tool inspection
; R_TOOLINSP_MDIC1              ; CNC in MDI tool inspection
; R_REPOS_C1                    ; CNC in tool inspection
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #ERA_MARK2 M_CNCRD_SYN
;
; #Order number = 170
;
;#END EXCEPTIONS
;
SUB CNC_MODES
;
()                              ; Logic "1"
  = CNCRD([1].G.CNCAUTSTATUS,R_AUTSTATUS,M_CNCRD_SYN); CNC in automatic mode
  = AND R_AUTSTATUS $80 R_TOOLINSP_C1; CNC in tool inspection
  = AND R_AUTSTATUS $10000080 R_TOOLINSP_MDIC1; CNC in MDI tool inspection
  = AND R_AUTSTATUS $200 R_REPOS_C1; CNC in reposition
;
CPS R_TOOLINSP_C1 EQ $80        ; CNC in tool inspection
  AND M_MACHINE_POWER           ; Machine with power
  = M_TOOLINSP_C1               ; CNC in tool inspection
;
CPS R_TOOLINSP_MDIC1 EQ $10000080 ; CNC in MDI tool inspection
  AND M_MACHINE_POWER           ; Machine with power
  AND NOT M_DOOR_CLOSED         ; Door closed
  = M_TOOLINSP_MDIC1            ; CNC in MDI tool inspection with open door
;
CPS R_REPOS_C1 EQ $200          ; CNC in reposition
  AND M_MACHINE_POWER           ; Machine with power
  = M_REPOS_C1                  ; CNC in reposition
;
()                              ; Logic "1"
  = CNCRD([1].G.INTMAN,R_INTMAN,M_CNCRD_SYN); CNC work mode
;
(CPS R_INTMAN EQ 1              ; CNC in manual modes
  OR MANUALC1                   ; CNC in manual modes
  OR M_TOOLINSP_C1)             ; CNC in tool inspection
  = M_MANUALC1                  ; CNC in manual modes
;
()                              ; Logic "1"
  = CNCRD([1].G.GS[200],R_CNC_G200,M_CNCRD_SYN); Reading if G200 active in CNC
  = CNCRD([1].G.GS[201],R_CNC_G201,M_CNCRD_SYN); Reading if G201 active in CNC
;
CPS R_CNC_G200 EQ 1             ; G200 active at the CNC
  OR CPS R_CNC_G201 EQ 1        ; G201 active at the CNC
  = M_MAN_INT_AUTO              ; CNC in manual intervention in automatic
;
M_MANUALC1                      ; CNC in manual modes
  AND MDIC1                     ; CNC in MDI mode
  = M_MAN_MDIC1                 ; CNC in Jog and MDI modes
;
AUTOMATC1                       ; CNC in AUTOMAT modes
  AND INCYCLEC1                 ; CNC in cycle
  = M_AUTO_INCYCLE              ; CNC in cycle in AUTOMAT mode
;
()                              ; Logic "1"
  = RES LATCHM                  ; Axes not maintained
;
M_MACHINE_POWER                 ; Machine with power
  = CNCRD([1].G.CNCMANSTATUS,R_MAN_STATUS,M_CNCRD_SYN);CNC status in manual mode
  = AND R_MAN_STATUS $F0 R_MAN_STATUS_FILTER ;CNC status in filtered manual mode
;
(MANUALC1                       ; CNC in Manual mode
  AND NOT MDIC1                 ; CNC in MDI mode
  AND (CPS R_MAN_STATUS_FILTER EQ $10 ; Axis homing with subroutine
  OR CPS R_MAN_STATUS_FILTER EQ $20)  ; Homing of one axis
  OR ZERO)                      ; Running a reference search
  AND M_MACHINE_POWER           ; Machine with power
  = M_ZERO                      ; CNC in homing mode
;
M_MACHINE_POWER                 ; Machine with power
  = CNCRD([1].G.HGS1, R_HGS1,M_CNCRD_SYN) ; Read G functions C1
;
()                              ; Logic "1"
  = VIRTUALJOGENA               ; Enable virtual JOG panel
;
; ------------ Broaching cycle conditions
;
M_M100_C1                       ; M100: Start of broaching cycle
  = SET M_BROACHING_CYCLE       ; Broaching cycle
;
M_BROACHING_CYCLE               ; Broaching cycle
  AND NOT M_MACHINE_POWER       ; Machine with power
  = SET M_BROACHING_EMERG       ; Emergency during broaching cycle
;
M_M101_C1                       ; M101: End of broaching cycle
  = RES M_BROACHING_CYCLE       ; Broaching cycle
  = RES M_BROACHING_EMERG       ; Emergency during broaching cycle
;
M_BROACHING_EMERG               ; Emergency during broaching cycle
  = MSG2                        ; Broaching cycle emergency
;
M_BROACHING_EMERG               ; Emergency during broaching cycle
  AND ENABLEZ                   ; Z axis in movement
  AND M_MACHINE_POWER           ; Machine with power
  AND (NOT MANUALC1             ; CNC in manual modes
  OR M_MAN_MDIC1)               ; CNC in Jog and MDI modes
  AND NOT M_BROACHING_REPOS     ; Post-Emergency Gantry Repositioning
  AND NOT M_GANTRYOFF           ; CNC decouples the gantry axis
  = ERR10                       ; Only gantry repositioning with M200
;
M_BROACHING_EMERG               ; Emergency during broaching cycle
  AND NOT M_MAN_MDIC1           ; CNC in Jog and MDI modes
  = B2R_STARTC1                 ; No START, Broaching cycle active
;
M_M90_C1                        ; M90: Tune up mode
  AND M_MACHINE_POWER           ; Machine with power
  = SET M_TUNE_MODE             ; Tune up mode
;
M_M91_C1                        ; M91: End Tune up mode
  OR NOT M_MACHINE_POWER        ; Machine with power
  = RES M_TUNE_MODE             ; Tune up mode
;
ENABLEZ                         ; Z axis in movement
  AND ENABLEC                   ; C axis in movement
  AND NOT M_TUNE_MODE           ; Tune up mode
  = ERR22                       ; No interpolation allowed
;
END
