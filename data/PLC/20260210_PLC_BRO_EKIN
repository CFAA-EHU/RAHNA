;------------------------------------------------------------------------------
;                        READ DRIVE STATUS AXES
;------------------------------------------------------------------------------
;******************************************************************************
;
;1.-Read variables of the drive
;2.-Depending on the value of these variables:
;   -->Drive without power
;   -->Drive not OK
;   -->Drive with power
;
;******************************************************************************
;
;******************************************************************************
;                         INPUT RESOURCES
;******************************************************************************
;
; DRSTASZ1                      ; B0 Z axis drive status
; DRSTAFZ1                      ; B1 Z axis drive status
; DRSTASZ1                      ; B0 Z1 axis drive status
; DRSTAFZ1                      ; B1 Z1 axis drive status
; DRSTASC                       ; B0 C axis drive status
; DRSTAFC                       ; B1 C axis drive status
;
;******************************************************************************
;                         OUTPUT RESOURCES
;******************************************************************************
;
; B1R_DR_STATUS                 ; No permission to apply power due to Z drive
; M_DR_STATUS_Z                 ; No permission to apply power due to Z drive
; B1R_DR_NOT_POWER              ; Z drive without power
; M_DR_NOT_POWER_Z              ; Z without power
; B1R_FEEDHOLC1                 ; FEEDHOLDC1, Z drive without torque
; M_FEEDHOLC1_Z                 ; FEEDHOLDC1, Z drive without torque
; B1R_DR_TORQUE                 ; Z drive with torque
; M_DR_TORQUE_Z                 ; Z drive with torque
;
;******************************************************************************
;                         INTERNAL RESOURCES
;******************************************************************************
; R_DRST_Z                      ; Z drive status register
; R_DRST_Z1                     ; Z1 drive status register
; R_DRST_C                      ; C drive status register
;
;******************************************************************************
;                         EXCEPTIONS
;******************************************************************************
;
;#BEGIN EXCEPTIONS
;
; #Order number = 180
;
;#END EXCEPTIONS
;
SUB DIGITAL_DRIVE_FAGOR_AXES
;
DRSTASZ                         ; B0 Z drive status
  = B0R_DRST_Z                  ; B0 Z drive status register
;
DRSTAFZ                         ; B1 Z drive status
  = B1R_DRST_Z                  ; B1 Z drive status register
;
CPS R_DRST_Z LT 1               ; Z drive ready
  = B1R_DR_STATUS               ; No permission to apply power due to Z drive
  = M_DR_STATUS_Z               ; No permission to apply power due to Z drive
;
CPS R_DRST_Z LT 2               ; Z drive with power
  = B1R_DR_NOT_POWER            ; Z without power
  = M_DR_NOT_POWER_Z            ; Z without power
;
CPS R_DRST_Z LT 3               ; Z with torque
  = B1R_FEEDHOLC1               ; FEEDHOLDC1, Z drive without torque
  = M_FEEDHOLC1_Z               ; FEEDHOLDC1, Z drive without torque
;
CPS R_DRST_Z EQ 3               ; Z drive with torque
  = B1R_DR_TORQUE               ; Z drive with torque
  = M_DR_TORQUE_Z               ; Z drive with torque
;
DRSTASZ1                        ; B0 Z1 drive status
  = B0R_DRST_Z1                 ; B0 Z1 drive status register
;
DRSTAFZ1                        ; B1 Z1 drive status
  = B1R_DRST_Z1                 ; B1 Z1 drive status register
;
